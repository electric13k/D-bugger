# GEMINI_API_KEY: Required for Gemini AI API calls and thinking reasoning.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Optional OpenRouter API Key for free high-context models (e.g. DeepSeek-R1 Free, LLaMA 3.3 70B Free, Qwen 2.5 Coder 32B Free).
OPENROUTER_API_KEY=""

# GITHUB_TOKEN: Optional GitHub Personal Access Token for live repository management and MCP operations.
GITHUB_TOKEN=""

# EMAIL_SERVICE_KEY / RESEND_API_KEY: Optional key for dispatching summary reports to email.
EMAIL_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
